<script>
if(window.pdfjsLib){
pdfjsLib.GlobalWorkerOptions.workerSrc='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
}
function downloadBlob(blob,name){
const url=URL.createObjectURL(blob);
const a=document.createElement('a');
a.href=url;a.download=name;
document.body.appendChild(a);a.click();a.remove();
setTimeout(()=>URL.revokeObjectURL(url),30000);
}
async function mergePDF(){
const files=Array.from(document.getElementById('mergeFiles').files);
const msg=document.getElementById('mergeMsg');
msg.textContent='';
if(files.length<2){msg.textContent='Please select at least two PDF files.';return;}
try{
const merged=await PDFLib.PDFDocument.create();
for(const file of files){
const doc=await PDFLib.PDFDocument.load(await file.arrayBuffer());
const pages=await merged.copyPages(doc,doc.getPageIndices());
pages.forEach(page=>merged.addPage(page));
}
const bytes=await merged.save();
downloadBlob(new Blob([bytes],{type:'application/pdf'}),'merged.pdf');
msg.textContent='PDF files merged successfully!';
}catch(e){msg.textContent='Could not merge these PDFs. Please check the files.';}
}
async function splitPDF(){
const file=document.getElementById('splitFile').files[0];
const range=document.getElementById('pageRange').value.trim();
const msg=document.getElementById('splitMsg');
msg.textContent='';
if(!file||!range){msg.textContent='Choose a PDF and enter page numbers.';return;}
try{
const source=await PDFLib.PDFDocument.load(await file.arrayBuffer());
const total=source.getPageCount();
const pages=new Set();
for(const part of range.split(',')){
const bits=part.trim().split('-').map(x=>x.trim());
if(bits.length>2||bits.some(x=>!/^\\d+$/.test(x)))throw Error();
const start=Number(bits[0]),end=bits.length===2?Number(bits[1]):start;
if(start<1||end<start||end>total)throw Error();
for(let p=start;p<=end;p++)pages.add(p-1);
}
const output=await PDFLib.PDFDocument.create();
const copied=await output.copyPages(source,[...pages].sort((a,b)=>a-b));
copied.forEach(p=>output.addPage(p));
downloadBlob(new Blob([await output.save()],{type:'application/pdf'}),'split-pages.pdf');
msg.textContent='Selected pages extracted successfully!';
}catch(e){msg.textContent='Invalid page range or PDF file. Check the page numbers.';}
}
async function convertPDF(){
const file=document.getElementById('imagePDF').files[0];
const msg=document.getElementById('imageMsg');
const downloads=document.getElementById('imageDownloads');
msg.textContent='';downloads.innerHTML='';
if(!file){msg.textContent='Please select a PDF file.';return;}
try{
const pdf=await pdfjsLib.getDocument({data:await file.arrayBuffer()}).promise;
for(let i=1;i<=pdf.numPages;i++){
const page=await pdf.getPage(i);
const viewport=page.getViewport({scale:1.5});
const canvas=document.createElement('canvas');
canvas.width=viewport.width;canvas.height=viewport.height;
await page.render({canvasContext:canvas.getContext('2d'),viewport}).promise;
const blob=await new Promise(resolve=>canvas.toBlob(resolve,'image/jpeg',0.9));
if(!blob)throw Error();
const url=URL.createObjectURL(blob);
const link=document.createElement('a');
link.href=url;link.download='page-'+i+'.jpg';
link.textContent='Download Page '+i+' JPG';
link.style.display='block';link.style.margin='12px 0';
downloads.appendChild(link);
}
msg.textContent=pdf.numPages+' pages converted successfully!';
}catch(e){msg.textContent='Could not convert this PDF. Please try another file.';}
}
</script>
