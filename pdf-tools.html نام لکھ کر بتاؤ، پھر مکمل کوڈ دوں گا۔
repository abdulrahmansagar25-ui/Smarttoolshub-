<p>Extract selected pages from a PDF document.</p>
<label>Select PDF file</label>
<input type="file" id="splitFile" accept="application/pdf">
<label>Pages to extract (example: 1,3,5-7)</label>
<input type="text" id="pageRange" placeholder="1,3,5-7">
<button onclick="splitPDF()">Split PDF</button>
<div class="msg" id="splitMsg"></div>
</div>

